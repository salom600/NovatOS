#!/usr/bin/env bash
#
# /usr/local/bin/novatos-session
# =================================
# Smart session launcher for NovatOS Live Mode.
#
# GPU fallback chain (tries each in order):
#   1. Hyprland with GPU acceleration (if KMS is available)
#   2. Hyprland with llvmpipe (software rendering)
#   3. Sway with pixman (software rendering, most compatible)
#   4. TTY console (ultimate fallback)
#
# This ensures NovatOS Live boots on ANY hardware from 2009 to 2026:
#   - AMD R2 (old integrated) → software rendering
#   - NVIDIA GT 240M (old dedicated) → software rendering
#   - Modern AMD/NVIDIA/Intel → GPU acceleration
#
set -euo pipefail

LOG="/var/log/novatos-session.log"
echo "[$(date)] novatos-session starting..." >> "$LOG"

# Detect if KMS (kernel mode setting) is available
has_kms() {
    # Check if any KMS device exists and is functional
    [ -d /sys/class/drm ] || return 1
    local cards=$(ls /sys/class/drm/card* 2>/dev/null | grep -v render | head -5)
    [ -n "$cards" ] || return 1

    # Check if nomodeset is in kernel params (forces software rendering)
    if grep -q nomodeset /proc/cmdline 2>/dev/null; then
        return 1
    fi

    # Check if any DRM driver is loaded
    if lsmod | grep -qE 'amdgpu|radeon|i915|nouveau|nvidia'; then
        return 0
    fi

    return 1
}

# Check if we have working GL acceleration
has_gl_accel() {
    if command -v glxinfo >/dev/null 2>&1; then
        glxinfo 2>/dev/null | grep -q "direct rendering: Yes" && return 0
    fi
    # Check for Vulkan ICD files (indicates GPU drivers are installed)
    [ -n "$(ls /usr/share/vulkan/icd.d/*.json 2>/dev/null)" ] && return 0
    return 1
}

# ─── Attempt 1: Hyprland with GPU acceleration ───
if has_kms && has_gl_accel 2>/dev/null; then
    echo "[$(date)] Attempting Hyprland with GPU acceleration..." >> "$LOG"
    export WLR_NO_HARDWARE_CURSORS=1
    export HYPRCURSOR_THEME=breeze_cursors
    # Try Hyprland for 10 seconds; if it crashes, move to next fallback
    timeout 10 hyprland >/tmp/hyprland.log 2>&1 &
    HYPRLAND_PID=$!
    sleep 5

    if kill -0 $HYPRLAND_PID 2>/dev/null; then
        echo "[$(date)] Hyprland started with GPU acceleration" >> "$LOG"
        wait $HYPRLAND_PID
        exit 0
    else
        echo "[$(date)] Hyprland GPU mode failed, trying llvmpipe..." >> "$LOG"
        kill $HYPRLAND_PID 2>/dev/null || true
        sleep 1
    fi
fi

# ─── Attempt 2: Hyprland with llvmpipe (software rendering) ───
echo "[$(date)] Attempting Hyprland with llvmpipe (software rendering)..." >> "$LOG"
export WLR_RENDERER=gles2
export LIBGL_ALWAYS_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1
export HYPRCURSOR_THEME=breeze_cursors

timeout 10 hyprland >/tmp/hyprland-llvm.log 2>&1 &
HYPRLAND_PID=$!
sleep 5

if kill -0 $HYPRLAND_PID 2>/dev/null; then
    echo "[$(date)] Hyprland started with llvmpipe" >> "$LOG"
    wait $HYPRLAND_PID
    exit 0
else
    echo "[$(date)] Hyprland llvmpipe failed, trying Sway..." >> "$LOG"
    kill $HYPRLAND_PID 2>/dev/null || true
    sleep 1
fi

# ─── Attempt 3: Sway with pixman (most compatible software renderer) ───
echo "[$(date)] Attempting Sway with pixman..." >> "$LOG"
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1
export SWAYSOCK=/tmp/sway-sock

timeout 10 sway >/tmp/sway.log 2>&1 &
SWAY_PID=$!
sleep 5

if kill -0 $SWAY_PID 2>/dev/null; then
    echo "[$(date)] Sway started with pixman" >> "$LOG"
    wait $SWAY_PID
    exit 0
else
    echo "[$(date)] Sway failed, falling back to TTY" >> "$LOG"
    kill $SWAY_PID 2>/dev/null || true
fi

# ─── Fallback: TTY console ───
echo "[$(date)] All desktop attempts failed. Falling back to TTY console." >> "$LOG"
cat <<'EOF'

╔══════════════════════════════════════════════════════════╗
║              NovatOS Live — Console Mode                   ║
╠══════════════════════════════════════════════════════════╣
║                                                          ║
║  No GPU acceleration available.                          ║
║  You can still use the system from this console.          ║
║                                                          ║
║  Useful commands:                                        ║
║    novatos-install   — Launch the installer              ║
║    archinstall       — Direct Arch installer              ║
║    reboot            — Restart                           ║
║    poweroff          — Shut down                         ║
║                                                          ║
╚══════════════════════════════════════════════════════════╝

EOF
exec /bin/bash -l
