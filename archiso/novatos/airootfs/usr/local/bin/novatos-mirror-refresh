#!/usr/bin/env bash
#
# /usr/local/bin/novatos-mirror-refresh
# =====================================
# Refreshes the pacman mirrorlist using reflector.
# Called from the welcome app and on demand by the user.
#
set -euo pipefail
exec sudo -E reflector \
    --protocol https \
    --latest 50 \
    --sort rate \
    --save /etc/pacman.d/mirrorlist \
    --download-timeout 5
