#!/usr/bin/env bash
#
# /usr/local/bin/novatos-gpu-info
# ================================
# Print detected GPU info and the driver that's currently in use.
# Useful for the welcome app and for users debugging graphics issues.
#
set -euo pipefail

echo "=== NovatOS GPU Detection ==="
echo

lspci -nnk | grep -iE 'vga|3d|display' -A2 || true

echo
echo "=== Loaded GPU kernel modules ==="
lsmod | grep -iE 'nvidia|amdgpu|radeon|i915|nouveau' || true

echo
echo "=== Vulkan ICDs available ==="
ls -la /usr/share/vulkan/icd.d/ 2>/dev/null || true

echo
echo "=== OpenGL / EGL drivers ==="
glxinfo 2>/dev/null | grep -iE 'vendor|renderer|version' | head -8 || true
