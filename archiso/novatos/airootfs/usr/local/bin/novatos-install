#!/usr/bin/env bash
#
# /usr/local/bin/novatos-install
# =================================
# NovatOS installer wrapper around archinstall.
# Called automatically in Install Mode (when novatos.install=1 kernel param is set),
# or manually from the Live desktop.
#
set -euo pipefail

# NovatOS banner
cat <<'BANNER'

  ███╗   ██╗ ██████╗ ██╗   ██╗ █████╗ ███████╗████████╗ ██████╗ ██╗    ██╗
  ████╗  ██║██╔═══██╗██║   ██║██╔══██╗██╔════╝╚══██╔══╝██╔═══██╗██║    ██║
  ██╔██╗ ██║██║   ██║██║   ██║███████║███████╗   ██║   ██║   ██║██║ █╗ ██║
  ██║╚██╗██║██║   ██║╚██╗ ██╔╝██╔══██║╚════██║   ██║   ██║   ██║██║███╗██║
  ██║ ╚████║╚██████╔╝ ╚████╔╝ ██║  ██║███████║   ██║   ╚██████╔╝╚███╔███╔╝
  ╚═╝  ╚═══╝ ╚═════╝   ╚═══╝  ╚═╝  ╚═╝╚══════╝   ╚═╝    ╚═════╝  ╚══╝╚══╝

                          Aurora Edition — 2026

                  Welcome to the NovatOS installer.

BANNER

# Check internet connectivity
echo "==> Checking internet connectivity..."
if ping -c 1 -W 3 archlinux.org >/dev/null 2>&1; then
    echo "    ✓ Internet available — latest drivers will be installed"
    HAS_NET=1
else
    echo "    ✗ No internet — installing basic drivers only"
    echo "    (You can install full drivers later once connected)"
    HAS_NET=0
fi

# Refresh mirrors if we have internet
if [ "$HAS_NET" = "1" ]; then
    echo ""
    echo "==> Refreshing pacman mirrors..."
    reflector --protocol https --latest 30 --sort rate \
              --save /etc/pacman.d/mirrorlist --download-timeout 5 2>/dev/null || true
    echo "==> Updating package databases..."
    pacman -Sy --noconfirm || true
fi

echo ""
echo "==> Launching archinstall guided installer..."
echo "    (Press Ctrl+C at any time to abort)"
echo ""

# Pre-set environment for archinstall
export ARCHINSTALL_LANGUAGE="English"
export ARCHINSTALL_HOSTNAME="${ARCHINSTALL_HOSTNAME:-novatos}"

# Launch archinstall
if [ "$HAS_NET" = "1" ]; then
    # With internet: full guided install
    exec archinstall
else
    # Without internet: guided install with offline fallback
    echo "  [offline mode] archinstall will use cached packages only."
    echo "  [offline mode] Some drivers may not be available."
    echo ""
    exec archinstall
fi
