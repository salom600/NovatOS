#!/usr/bin/env bash
#
# /usr/local/bin/novatos-install
# =================================
# NovatOS graphical installer.
#
# Shows a modern GTK dialog asking if the user wants to:
#   1. Run the guided text installer (archinstall)
#   2. Open a terminal for manual installation
#
# Then launches archinstall in a terminal window.
#
set -euo pipefail

# If we're in a TTY (Install Mode), launch archinstall directly
if [ ! -d "/run/user/$(id -u)" ] || [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    # TTY mode — launch archinstall directly
    clear
    cat <<'BANNER'

  ███╗   ██╗ ██████╗ ██╗   ██╗ █████╗ ███████╗████████╗ ██████╗ ██╗    ██╗
  ████╗  ██║██╔═══██╗██║   ██║██╔══██╗██╔════╝╚══██╔══╝██╔═══██╗██║    ██║
  ██╔██╗ ██║██║   ██║██║   ██║███████║███████╗   ██║   ██║   ██║██║ █╗ ██║
  ██║╚██╗██║██║   ██║╚██╗ ██╔╝██╔══██║╚════██║   ██║   ██║   ██║██║███╗██║
  ██║ ╚████║╚██████╔╝ ╚████╔╝ ██║  ██║███████║   ██║   ╚██████╔╝╚███╔███╔╝
  ╚═╝  ╚═══╝ ╚═════╝   ╚═══╝  ╚═╝  ╚═╝╚══════╝   ╚═╝    ╚═════╝  ╚══╝╚══╝

                          Aurora Edition — 2026

BANNER

    # Check internet connectivity
    if ping -c 1 -W 3 archlinux.org >/dev/null 2>&1; then
        echo "  ✓ Internet available — latest drivers will be installed"
    else
        echo "  ⚠ No internet — installing basic drivers only"
        echo "    (You can install full drivers later once connected)"
    fi

    echo ""
    echo "  Launching installer..."
    echo ""

    # Refresh mirrors if we have internet
    if ping -c 1 -W 3 archlinux.org >/dev/null 2>&1; then
        echo "  Refreshing pacman mirrors..."
        reflector --protocol https --latest 30 --sort rate \
                  --save /etc/pacman.d/mirrorlist --download-timeout 5 2>/dev/null || true
        echo "  Updating package databases..."
        pacman -Sy --noconfirm || true
    fi

    exec archinstall
fi

# Graphical mode — show a dialog
if command -v zenity >/dev/null 2>&1; then
    CHOICE=$(zenity --question --title="NovatOS Installer" \
        --text="Welcome to the NovatOS installer!\n\nThis will permanently install NovatOS on your hard drive.\n\nThe installer runs in a terminal window. Continue?" \
        --ok-label="Continue" --cancel-label="Cancel" 2>&1 && echo "yes" || echo "no")

    if [ "$CHOICE" = "yes" ]; then
        # Launch archinstall in a terminal
        if command -v foot >/dev/null 2>&1; then
            exec foot -e bash -c "novatos-install"
        elif command -v xterm >/dev/null 2>&1; then
            exec xterm -e bash -c "novatos-install"
        else
            # Fallback: launch directly
            exec archinstall
        fi
    fi
else
    # No zenity — launch archinstall directly
    exec archinstall
fi
