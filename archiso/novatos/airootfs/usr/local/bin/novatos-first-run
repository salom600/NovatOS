#!/usr/bin/env bash
#
# /usr/local/bin/novatos-first-run
# =================================
# Runs on first login after boot (or after install).
# Installs: bauh (app store), paru (AUR helper), snapd, Flathub.
#
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E "$0" "$@"
fi

echo "==> [NovatOS] First-run setup starting..."

# 1. Remove live-only passwordless sudo
rm -f /etc/sudoers.d/10-novatos-live

# 2. Refresh mirrors
echo "==> Refreshing pacman mirrors..."
reflector --protocol https --latest 30 --sort rate \
          --save /etc/pacman.d/mirrorlist --download-timeout 5 || true

# 3. Update keyring
echo "==> Updating pacman keyring..."
pacman-key --init
pacman-key --populate archlinux
pacman -Sy --noconfirm archlinux-keyring || true

# 4. Install paru (AUR helper) — needed for bauh, snapd, etc.
if ! command -v paru >/dev/null 2>&1; then
    echo "==> Installing paru (AUR helper)..."
    pacman -S --needed --noconfirm base-devel git
    sudo -u "${SUDO_USER:-novatos}" bash -c '
        cd /tmp
        rm -rf paru-bin
        git clone https://aur.archlinux.org/paru-bin.git
        cd paru-bin
        makepkg -si --noconfirm
    ' || echo "  [warn] paru install failed"
fi

# 5. Install bauh (unified app store: AUR + Flatpak + Snap + AppImage)
if ! command -v bauh >/dev/null 2>&1; then
    echo "==> Installing bauh (app store)..."
    sudo -u "${SUDO_USER:-novatos}" paru -S --noconfirm bauh || echo "  [warn] bauh install failed"
fi

# 6. Install snapd
if ! command -v snapd >/dev/null 2>&1; then
    echo "==> Installing snapd..."
    sudo -u "${SUDO_USER:-novatos}" paru -S --noconfirm snapd || echo "  [warn] snapd install failed"
    systemctl enable --now snapd.socket 2>/dev/null || true
fi

# 7. Enable Flathub for Flatpak
echo "==> Enabling Flathub..."
flatpak remote-add --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo || true

# 8. GPU driver auto-detection
echo "==> Detecting GPU and ensuring correct drivers..."
if lspci -nnk | grep -i 'vga\|3d\|display' | grep -qi 'nvidia'; then
    echo "  NVIDIA GPU detected — nvidia-open already installed"
fi
if lspci -nnk | grep -i 'vga\|3d\|display' | grep -qi 'amd'; then
    echo "  AMD GPU detected — mesa/radeon drivers already installed"
fi
if lspci -nnk | grep -i 'vga\|3d\|display' | grep -qi 'intel'; then
    echo "  Intel GPU detected — mesa/intel-media drivers already installed"
fi

# 9. Enable services
echo "==> Enabling services..."
systemctl enable --now libvirtd 2>/dev/null || true
systemctl enable --now docker 2>/dev/null || true

# 10. Mark first-run complete
touch /etc/novatos-first-run-done
echo ""
echo "==> [NovatOS] First-run setup complete!"
echo ""
echo "  bauh (app store) is now available in the application menu."
echo "  Use it to install: Steam, LibreOffice, games, and more — with one click."
echo ""
echo "  Reboot recommended to apply all changes."
