## sudoers — NovatOS defaults
##
## On the live ISO the `novatos` user can sudo without a password so the
## Calamares installer and welcome app can do their thing without prompting.
## After install, /usr/local/bin/novatos-first-run removes the NOPASSWD line.

Defaults env_reset
Defaults mail_badpass
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

root ALL=(ALL:ALL) ALL

# Live ISO: passwordless sudo for the novatos user
novatos ALL=(ALL:ALL) NOPASSWD: ALL

# Wheel group (added by Calamares during install)
%wheel ALL=(ALL:ALL) ALL

@includedir /etc/sudoers.d
