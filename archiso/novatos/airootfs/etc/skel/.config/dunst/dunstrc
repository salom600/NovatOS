# NovatOS Dunst config — notification daemon
[global]
    monitor = 0
    follow = keyboard
    width = 360
    height = 80
    offset = 20x20
    origin = top-right
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 15
    separator_height = 4
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#4CC2FF"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Noto Sans 12
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/wofi --dmenu -p "Notification:"
    browser = /usr/bin/firefox
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    ignore_dbusclose = false

[urgency_low]
    background = "#0F1117CC"
    foreground = "#9DB7E0"
    timeout = 5

[urgency_normal]
    background = "#161922EE"
    foreground = "#FFFFFF"
    timeout = 10

[urgency_critical]
    background = "#FF6B6BEE"
    foreground = "#FFFFFF"
    frame_color = "#FF6B6B"
    timeout = 0
