# mkinitcpio preset for the 'linux-lts' package on NovatOS live ISO
# Uses the archiso.conf drop-in for HOOKS (includes the `archiso` live-boot hook)

PRESETS=('archiso')

ALL_kver='/boot/vmlinuz-linux-lts'
archiso_config='/etc/mkinitcpio.conf.d/archiso.conf'

archiso_image="/boot/initramfs-linux-lts.img"
