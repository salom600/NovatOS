{
    "__separator__": null,
    "additional-repositories": [],
    "archinstall-language": "English",
    "audio_config": {
        "audio": "pipewire"
    },
    "bootloader": "Systemd-boot",
    "config_version": "2.8.0",
    "debug": false,
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": []
    },
    "disk_encryption": null,
    "hostname": "novatos",
    "kernels": ["linux-zen"],
    "locale_config": {
        "kb_layout": "us",
        "locale": "en_US.UTF-8"
    },
    "mirror_config": {
        "mirror-regions": {}
    },
    "network_config": {
        "type": "iso"
    },
    "ntp": true,
    "packages": [
        "base",
        "base-devel",
        "linux",
        "linux-zen",
        "linux-firmware",
        "networkmanager",
        "plasma",
        "sddm",
        "dolphin",
        "konsole",
        "kate",
        "firefox",
        "discover",
        "flatpak",
        "git",
        "vim",
        "nano",
        "htop",
        "fastfetch"
    ],
    "parallel downloads": 0,
    "profile_config": {
        "gfx_driver": "All open-source (default)",
        "greeter": "sddm",
        "profile": {
            "custom_settings": {
                "Hyprland": {},
                "Kde": {},
                "Sway": {}
            },
            "details": ["Kde", "Sway", "Hyprland"],
            "main": "Desktop"
        }
    },
    "services": [
        "NetworkManager",
        "sddm",
        "bluetooth",
        "cups",
        "firewalld"
    ],
    "swap": true,
    "timezone": "auto"
}
