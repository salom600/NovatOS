## NovatOS pacman mirrors — pulled from archlinux.org at ISO build time
## by /root/customize_airootfs.sh. The mirrorlist is refreshed on the live
## system by /usr/local/bin/novatos-mirror-refresh on first boot.

# Defaults (will be overwritten at build time)
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
